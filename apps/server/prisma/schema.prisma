// Data model from docs/SPEC.md (section 5).
// SQLite for development: catalog values (role, status, type) are stored as strings;
// valid values live in packages/shared/src/domain.ts.
// Clinical dates (birth, attendance) are stored as "YYYY-MM-DD" strings to avoid timezone issues.
// The provider is fixed here on purpose: a pilot moves to PostgreSQL by changing it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Locality {
  id           String    @id
  name         String
  municipality String
  hasSignal    Boolean
  patients     Patient[]
}

model Campaign {
  id           String  @id
  name         String
  municipality String
  state        String
  date         String // YYYY-MM-DD, first day of the campaign
  endDate      String // YYYY-MM-DD, last day (same as date for one-day campaigns)
  localityIds  String // JSON array of Locality ids
  visits       Visit[]
}

model User {
  id       String @id
  username String @unique // login name, lowercase; staff are never listed on screen
  name     String
  role     String // intake | nutritionist | doctor | pathologist | admin
  pinHash  String // scrypt hash, demo only
}

model Patient {
  id            String    @id // UUID created on the device
  formId        String? // "4. ID" field of the form
  fullName      String // visual check only; never a key
  birthDate     String // YYYY-MM-DD
  birthState    String?
  phone         String?
  mobile        String?
  residence     String?
  localityId    String?
  locality      Locality? @relation(fields: [localityId], references: [id])
  affiliation   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt // change tracking for GET /api/sync/pull
  createdBy     String
  deviceId      String
  version       Int       @default(1)
  fieldVersions String    @default("{}") // JSON: field -> version
  // When linked, this record points to the main record. Nothing is deleted.
  linkedToId    String?
  linkedTo      Patient?  @relation("PatientLink", fields: [linkedToId], references: [id])
  linkedFrom    Patient[] @relation("PatientLink")
  visits        Visit[]

  @@index([birthDate])
  @@index([formId])
  @@index([updatedAt])
}

model Visit {
  id         String      @id
  patientId  String
  patient    Patient     @relation(fields: [patientId], references: [id])
  campaignId String
  campaign   Campaign    @relation(fields: [campaignId], references: [id])
  date       String // YYYY-MM-DD
  folio      String? // short folio "<prefix>-<seq>-<check>" (SPEC 6.3.1), unique per campaign
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt // change tracking for GET /api/sync/pull
  createdBy  String
  deviceId   String
  version    Int         @default(1)
  services   Service[]
  steps      VisitStep[]

  @@unique([campaignId, folio])
  @@index([updatedAt])
}

// One station a visit passes through (SPEC 6.3.1): nutritionist, doctor or pathologist.
model VisitStep {
  id          String    @id @default(uuid())
  visitId     String
  visit       Visit     @relation(fields: [visitId], references: [id])
  role        String // nutritionist | doctor | pathologist
  status      String    @default("PENDING") // PENDING | DONE | SKIPPED
  completedBy String?
  completedAt DateTime?
  reason      String? // why it was SKIPPED
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([visitId, role])
  @@index([updatedAt])
}

// A tablet with its unique folio prefix, assigned the first time it is online (SPEC 6.3.1).
model Device {
  id          String   @id // deviceId sent by the app (x-device-id)
  folioPrefix String   @unique // letter + digit, e.g. "B3"
  createdAt   DateTime @default(now())
}

model Service {
  id            String    @id
  visitId       String
  visit         Visit     @relation(fields: [visitId], references: [id])
  type          String // BREAST_REVIEW | ULTRASOUND | PAP | MAMMOGRAPHY
  templateId    String
  data          String    @default("{}") // JSON with template fields
  fieldVersions String    @default("{}") // JSON: field -> version (UPDATE_SERVICE_FIELDS)
  formImageRef  String?
  status        String    @default("DRAFT") // DRAFT | CONFIRMED
  confirmedBy   String?
  confirmedAt   DateTime?
  version       Int       @default(1)
}

model MatchReview {
  id         String    @id @default(uuid())
  patientAId String
  patientBId String
  score      Int
  reasons    String // JSON array of reason codes
  status     String    @default("OPEN") // OPEN | LINKED | DISMISSED
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model SyncConflict {
  id          String    @id @default(uuid())
  entity      String
  entityId    String
  field       String
  serverValue String?
  deviceValue String?
  deviceId    String
  userId      String
  clinical    Boolean   @default(false)
  status      String    @default("OPEN") // OPEN | RESOLVED
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model FormScan {
  id         String   @id @default(uuid())
  imageRef   String
  templateId String
  status     String   @default("QUEUED") // QUEUED | READ | CONFIRMED | FAILED
  extracted  String? // JSON: field -> { value, confidence }
  visitId    String?
  createdAt  DateTime @default(now())
  // Block 3a (form photo): visit link by folio for offline attachments, uploader, and who confirmed.
  campaignId     String?
  folio          String?
  originalName   String?
  mimeType       String?
  uploadedBy     String?
  confirmedRoles String  @default("[]") // JSON array of roles that confirmed their part

  @@index([visitId])
  @@index([campaignId, folio])
}

// Durable idempotency: every sync op id is stored once (Valkey is only the fast path).
model AppliedOp {
  opId      String   @id
  deviceId  String
  userId    String
  appliedAt DateTime @default(now())
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  actorId  String
  deviceId String?
  action   String
  entity   String?
  entityId String?
  detail   String? // short text, never clinical values

  @@index([entityId])
}

// ---------- Block 3b: Excel/CSV import (SPEC 6.7) ----------

// One uploaded file (or, later, one MCP propose_import call). Nothing here is a patient yet:
// every row waits for an explicit person decision before it reaches the single write path.
model ImportBatch {
  id            String      @id @default(uuid())
  source        String // TEMPLATE | EXCEL | MCP
  fileName      String?
  columnMapping String      @default("{}") // JSON: { confirmed, columns: [{ index, header, field, suggested }] }
  // Raw cells kept only until the column mapping is confirmed, then cleared (set to null).
  pendingRows   String?
  createdBy     String // user id or "agent:<token name>"
  status        String      @default("OPEN") // OPEN | DONE
  createdAt     DateTime    @default(now())
  rows          ImportRow[]

  @@index([createdAt])
}

model ImportRow {
  id         String      @id @default(uuid())
  batchId    String
  batch      ImportBatch @relation(fields: [batchId], references: [id])
  rowNumber  Int // spreadsheet row number, as the person sees it in Excel
  data       String // JSON: identification fields only
  status     String // NEW | POSSIBLE_MATCH | INVALID | CONFIRMED | DISCARDED
  reason     String? // plain Spanish reason when INVALID
  candidates String      @default("{}") // JSON: { patients: MatchCandidate[], rows: [{ rowNumber, reasons }] }
  decision   String? // REGISTERED | IS_HER | DISCARDED
  patientId  String?
  decidedBy  String?
  decidedAt  DateTime?

  @@unique([batchId, rowNumber])
}
