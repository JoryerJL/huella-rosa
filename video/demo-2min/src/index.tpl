      .sheet .grid span.h { background: #F1F1F1; font-weight: 700; color: #555555; }
      .cards { display: flex; gap: 36px; justify-content: center; align-items: flex-start; flex: 1; padding-top: 20px; }
      .card { width: 370px; background: #FFFFFF; border-radius: 16px; padding: 30px; border-top: 10px solid var(--rosa);
