      .beat-head .top { display: flex; align-items: center; gap: 28px; }
      .progress { display: flex; gap: 10px; }
      .progress i { width: 56px; height: 10px; border-radius: 5px; background: var(--rosa-claro); overflow: hidden; display: block; }
      .progress i b { display: block; width: 100%; height: 100%; background: var(--frambuesa); transform-origin: left center; transform: scaleX(0); }
      .progress i.done b { transform: scaleX(1); }
      .beat-head h2 { font-size: 68px; font-weight: 800; color: var(--vino); line-height: 1.08; letter-spacing: -.015em; }
      .beat-head p { font-size: 32px; line-height: 1.3; color: var(--tinta); max-width: 1820px; }
      .tags { position: absolute; left: 0; top: 410px; width: 1920px; height: 48px; }
      .tag { position: absolute; top: 0; width: 880px; display: flex; align-items: center; gap: 18px; font-size: 26px; font-weight: 700; color: var(--tinta); }
      .tag.a { left: 70px; } .tag.b { left: 1010px; }
