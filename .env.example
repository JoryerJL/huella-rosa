# Copia este archivo a .env y ajusta los valores. No subas .env al repo.

# Base de datos local (SQLite)
DATABASE_URL="file:./dev.db"

# Valkey (códigos de un solo uso, sesiones, límite de intentos, cola de avisos)
VALKEY_URL="redis://localhost:6379"

# Secreto para firmar sesiones (genera uno: openssl rand -hex 32)
SESSION_SECRET="cambia-esto"

# OCR: "mock" lee datos-ficticios/*.json; "pdf" extrae texto del PDF; "textract" usa AWS Textract
OCR_MODE="mock"

# Almacenamiento de PDF: "local" guarda en ./uploads; "s3" usa el bucket indicado
STORAGE_MODE="local"
AWS_REGION="us-east-1"
S3_BUCKET=""

# Avisos: "simulado" los muestra en la pantalla /simulador-sms; no hay envío real en el prototipo
AVISOS_MODE="simulado"
