        --tinta: #2E2E2E;
        --ok: #1C6632;
        --warn: #6B4700;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: var(--crema); }
      #root { position: relative; width: 1920px; height: 1080px; overflow: hidden;
              font-family: "Atkinson Hyperlegible Next", sans-serif; color: var(--tinta); background: var(--crema); }
      .scene { position: absolute; inset: 0; overflow: hidden; background: var(--crema); }
      .scene-content { width: 100%; height: 100%; display: flex; flex-direction: column; box-sizing: border-box; }
