<!doctype html>
<html lang="es-MX" data-resolution="@@ORIENT@@">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=@@W@@, height=@@H@@" />
    <title>Huella Rosa · Lanzamiento</title>
    <script src="assets/vendor/gsap.min.js"></script>
    <style>
      /* Generated by build.py from src/index.tpl. Do not edit index.html by hand. */
      @font-face {
        font-family: "Atkinson Hyperlegible Next";
        src: url("assets/fonts/atkinson-hyperlegible-next-latin-wght.woff2") format("woff2");
        font-weight: 200 800;
        font-style: normal;
      }
      :root {
        --frambuesa: #B7426C;
        --vino: #7D3B3B;
        --ciruela: #6A2B51;
        --ciruela-hondo: #4A1D39;
        --rosa: #FFA9B8;
        --rosa-claro: #FFD7DE;
        --crema: #FFF8F5;
        --tinta: #2E2E2E;
        --s: @@SCALE@@;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: @@W@@px; height: @@H@@px; overflow: hidden; background: var(--ciruela); }
      #root { position: relative; width: @@W@@px; height: @@H@@px; overflow: hidden;
              font-family: "Atkinson Hyperlegible Next", sans-serif; color: var(--crema); background: var(--ciruela); }
      .scene { position: absolute; inset: 0; overflow: hidden; }
      .scene-content { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center;
                       justify-content: center; box-sizing: border-box; text-align: center; }
      .mark path { stroke-dasharray: 1; stroke-dashoffset: 0; }
      .w { display: inline-block; }

      /* ===== Hook ===== */
      #hook { z-index: 1; background: var(--crema); color: var(--vino); }
      #hook .scene-content { gap: 44px; padding: 120px; }
      #hook .mark { width: 220px; height: 220px; }
      #hook h1 { font-size: 132px; font-weight: 800; letter-spacing: -.03em; line-height: 1.02; }
      #hook h1 .line { display: block; }
      #hook h1 .line + .line { color: var(--frambuesa); }

      /* ===== Stage: copy + tablet ===== */
      #stage { z-index: 5; background: var(--ciruela); clip-path: inset(0 0 0 100%); }
      .glow { position: absolute; border-radius: 50%; background: radial-gradient(circle, rgba(183, 66, 108, .55) 0%, rgba(183, 66, 108, 0) 70%); }
      .copy { position: absolute; background: var(--ciruela); }
      .copy-in { width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 28px; }
      .count { font-size: 28px; font-weight: 700; letter-spacing: .14em; color: var(--rosa); font-variant-numeric: tabular-nums; }
      .count b { color: var(--crema); }
      .copy h2 { font-weight: 800; line-height: 1.04; letter-spacing: -.02em; color: var(--crema); }
      .copy p { line-height: 1.32; color: var(--rosa-claro); }
      .tablet { position: absolute; border-radius: 34px; background: var(--tinta); padding: 18px;
                box-shadow: 0 40px 90px rgba(20, 6, 16, .55); }
      .screen { position: relative; width: @@SCREEN_W@@px; height: calc(@@SCREEN_W@@px * .625); overflow: hidden;
                border-radius: 14px; background: var(--crema); }
      .shot { position: absolute; inset: 0; opacity: 0; overflow: hidden; background: var(--crema); }
      .cam { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transform-origin: 0 0; will-change: transform; }
      .cam video { position: absolute; left: 0; top: 0; width: 100%; height: 100%; object-fit: fill; }
      .ring { position: absolute; left: calc(var(--x) * var(--s) * 1px); top: calc(var(--y) * var(--s) * 1px);
              width: calc(var(--w) * var(--s) * 1px); height: calc(var(--h) * var(--s) * 1px);
              border: 3px solid var(--frambuesa); border-radius: 10px; box-shadow: 0 0 0 4px rgba(255, 169, 184, .55); }
      .who { position: absolute; right: 16px; bottom: 16px; font-size: 22px; font-weight: 700; color: var(--crema);
             background: rgba(46, 46, 46, .82); border-radius: 999px; padding: 8px 20px; }
      .flash { position: absolute; inset: 0; background: var(--crema); opacity: 0; pointer-events: none; z-index: 50; }

      /* ===== End card ===== */
      #end { z-index: 9; background: var(--crema); color: var(--vino); }
      #end .scene-content { gap: 30px; padding: 120px 110px; }
      #end .mark { width: 190px; height: 190px; }
      .name { font-size: 140px; font-weight: 800; letter-spacing: -.03em; line-height: 1; color: var(--vino); }
      .tagline { font-size: 46px; font-weight: 700; color: var(--ciruela); line-height: 1.25; }
      .madefor { display: flex; align-items: center; gap: 22px; font-size: 32px; color: var(--tinta); margin-top: 18px; }
      .madefor img { width: 84px; height: 84px; border-radius: 14px; }
      .url { font-size: 40px; font-weight: 800; color: var(--frambuesa); letter-spacing: .01em; }

      /* ===== 16:9 ===== */
      .f169 .glow { width: 1400px; height: 1400px; left: 600px; top: -160px; }
      .f169 .copy { left: 0; top: 0; width: 790px; height: 1080px; padding: 120px 40px 120px 110px; }
      .f169 .copy h2 { font-size: 78px; }
      .f169 .copy p { font-size: 34px; }
      .f169 .tablet { left: 794px; top: 197px; }
      .f169 #hook .tagline, .f169 #end .tagline { max-width: 1500px; }

      /* ===== 9:16 ===== */
      .f916 .glow { width: 1500px; height: 1500px; left: -210px; top: 700px; }
      .f916 .copy { left: 0; top: 0; width: 1080px; height: 830px; padding: 190px 80px 40px; }
      .f916 .copy-in { justify-content: flex-end; }
      .f916 .copy h2 { font-size: 92px; }
      .f916 .copy p { font-size: 40px; }
      .f916 .tablet { left: 54px; top: 900px; }
      .f916 #hook h1 { font-size: 118px; }
      .f916 #end .scene-content { padding: 220px 80px; }
      .f916 .name { font-size: 128px; }
      .f916 .tagline { font-size: 52px; }
      .f916 .madefor { flex-direction: column; text-align: center; }
    </style>
  </head>
  <body>
    <div id="root" class="@@FMT@@" data-composition-id="main" data-start="0" data-duration="@@END@@" data-width="@@W@@" data-height="@@H@@" data-fps="30">

      <section id="hook" class="scene clip" @@W_hook@@ data-track-index="1">
        <div class="scene-content">
          @@MARK@@
          <h1><span class="line" id="hook-l1">Una mujer.</span><span class="line" id="hook-l2">Un solo expediente.</span></h1>
        </div>
      </section>

      <div id="stage" class="scene">
        <i class="glow" data-layout-ignore></i>
        @@COPIES@@
        <div class="tablet" id="tablet">
          <div class="screen" id="screen" data-layout-allow-overflow>
          @@SHOTS@@
          <i class="flash" id="flash"></i>
          </div>
        </div>
      </div>

      <section id="end" class="scene clip" @@W_end@@ data-track-index="2">
        <div class="scene-content">
          @@MARK@@
          <div class="name" id="end-name">Huella Rosa</div>
          <div class="tagline" id="end-tagline">@@TAGLINE@@</div>
          <div class="madefor" id="end-madefor"><img src="assets/brand/eira-logo.jpeg" alt="" /><span>Hecho para EIRA Movimiento Rosa A.C.</span></div>
          <div class="url" id="end-url">huella-rosa.jjjl.dev</div>
        </div>
      </section>
    </div>
    <script>
@@MOTION@@
    </script>
  </body>
</html>
