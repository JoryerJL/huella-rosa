{
  "name": "huella-rosa",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm run dev -w @er/server\" \"npm run dev -w @er/web\"",
    "build": "npm run build -w @er/web",
    "db:migrate": "npm run db:migrate -w @er/server",
    "seed": "npm run seed -w @er/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
