      .ph .body small { font-size: 34px; font-weight: 700; color: var(--frambuesa); letter-spacing: .1em; text-transform: uppercase; }
      .ph .body strong { font-size: 66px; font-weight: 800; color: var(--vino); line-height: 1.1; }
      .ph .body em { font-style: normal; font-size: 32px; color: #555555; }

      /* ===== Trust ===== */
      #trust { z-index: 8; background: var(--ciruela); color: var(--crema); }
      #trust .scene-content { padding: 110px 160px; gap: 46px; justify-content: center; }
