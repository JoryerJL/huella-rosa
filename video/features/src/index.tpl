<!doctype html>
<html lang="es-MX" data-resolution="landscape">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <title>Huella Rosa · @@TITLE@@</title>
    <script src="assets/vendor/gsap.min.js"></script>
    <style>
      /* Generated by build.py from src/index.tpl. Do not edit index.html by hand. */
      @font-face {
        font-family: "Atkinson Hyperlegible Next";
        src: url("assets/fonts/atkinson-hyperlegible-next-latin-wght.woff2") format("woff2");
        font-weight: 200 800;
        font-style: normal;
      }
      :root {
        --frambuesa: #B7426C;
        --vino: #7D3B3B;
        --ciruela: #6A2B51;
        --rosa: #FFA9B8;
        --rosa-claro: #FFD7DE;
        --crema: #FFF8F5;
        --tinta: #2E2E2E;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: var(--crema); }
      #root { position: relative; width: 1920px; height: 1080px; overflow: hidden;
              font-family: "Atkinson Hyperlegible Next", sans-serif; color: var(--tinta); background: var(--crema); }
      .scene { position: absolute; inset: 0; overflow: hidden; background: var(--crema); }
      .kicker { font-size: 28px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--frambuesa); }
      .num { color: var(--vino); opacity: .55; margin-right: 18px; }

      /* ===== Title card ===== */
      #title { z-index: 1; background: var(--rosa-claro); }
      #title .inner { position: absolute; left: 160px; top: 0; bottom: 0; width: 1500px; display: flex; flex-direction: column; justify-content: center; gap: 34px; }
      #title h1 { font-size: 110px; font-weight: 800; line-height: 1.02; letter-spacing: -.025em; color: var(--vino); }
      #title p { font-size: 46px; line-height: 1.3; font-weight: 600; color: var(--ciruela); max-width: 1440px; }
      #title .corner { position: absolute; right: 120px; bottom: 90px; display: flex; align-items: center; gap: 18px; font-size: 36px; font-weight: 800; color: var(--vino); }
      #title .corner svg { width: 76px; height: 76px; }

      /* ===== Clip in the tablet mockup ===== */
      #demo { z-index: 2; }
      .head { position: absolute; left: 0; top: 0; width: 1920px; height: 200px; padding: 52px 80px 0; display: flex; flex-direction: column; gap: 12px; }
      .head h2 { font-size: 58px; font-weight: 800; color: var(--vino); line-height: 1.08; letter-spacing: -.015em; }
      .tablet { position: absolute; border-radius: 44px; background: var(--tinta); box-shadow: 0 26px 54px rgba(46, 46, 46, .24); }
      .tablet i { position: absolute; top: 12px; left: 50%; width: 14px; height: 5px; margin-left: -7px; border-radius: 3px; background: #555555; }
      .screen { position: absolute; overflow: hidden; border-radius: 14px; background: var(--crema); z-index: 3; }
      .screen video { position: absolute; left: 0; top: 0; width: 100%; height: 100%; object-fit: cover; }
      .label { position: absolute; z-index: 3; font-size: 28px; font-weight: 700; color: var(--tinta); }
      @@LAYOUT@@

      /* ===== End card ===== */
      #close { z-index: 4; }
      #close .inner { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px; }
      #close .mark { width: 200px; height: 200px; }
      #close .name { font-size: 130px; font-weight: 800; letter-spacing: -.03em; color: var(--vino); line-height: 1; }
      .madefor { display: flex; align-items: center; gap: 22px; margin-top: 18px; font-size: 38px; color: var(--tinta); }
      .madefor img { width: 104px; height: 104px; border-radius: 18px; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="@@END@@" data-width="1920" data-height="1080" data-fps="30">

      <section id="title" class="scene clip" @@W_title@@ data-track-index="1">
        <div class="inner">
          <div class="kicker" id="t-k"><span class="num">@@NUM@@</span>@@GROUP@@</div>
          <h1 id="t-h">@@TITLE@@</h1>
          <p id="t-p">@@SENTENCE@@</p>
        </div>
        <div class="corner" id="t-brand">@@MARK@@<span>Huella Rosa</span></div>
      </section>

      <section id="demo" class="scene clip" @@W_demo@@ data-track-index="2">
        <div class="head">
          <div class="kicker" id="d-k"><span class="num">@@NUM@@</span>@@TITLE@@</div>
          <h2 id="d-h">@@CAPTION@@</h2>
        </div>
        @@TABLETS@@
      </section>

      @@SCREENS@@

      <section id="close" class="scene clip" @@W_close@@ data-track-index="9">
        <div class="inner">
          <div class="mark" id="cl-mark">@@MARK@@</div>
          <div class="name" id="cl-name">Huella Rosa</div>
          <div class="madefor" id="cl-eira"><img src="assets/brand/eira-logo.jpeg" alt="" /><span>Hecho para EIRA Movimiento Rosa A.C.</span></div>
        </div>
      </section>
    </div>
    <script>
@@MOTION@@
    </script>
  </body>
</html>
