      .pill.online { color: var(--ok); background: #E3F1E6; }
      .pill.offline { color: var(--warn); background: #FBEFD5; }
      .screen { position: absolute; top: 496px; width: 832px; height: 520px; overflow: hidden; border-radius: 12px; z-index: 7; }
      .screen.a { left: 74px; } .screen.b { left: 1014px; }
      .screen video, .screen .ph { position: absolute; left: 0; top: 0; }
      .screen video { width: 832px; height: 520px; object-fit: cover; background: var(--crema); }
      /* Placeholder drawn at the real tablet size (1280x800) and scaled into the frame. */
      .ph { width: 1280px; height: 800px; transform: scale(.65); transform-origin: 0 0; background: var(--crema); display: flex; flex-direction: column; }
