      #p3 { background: var(--ciruela); }
      #p3 .scene-content { padding: 150px 140px; justify-content: flex-start; gap: 40px; }
      #p3 .headline { color: var(--crema); font-size: 110px; max-width: 1300px; }
      #p3 .kicker { color: var(--rosa); }
      .sierra { position: absolute; left: 0; right: 0; bottom: 0; height: 520px; }
      .nosignal { position: absolute; right: 200px; top: 150px; width: 300px; height: 300px; }
